
-- ==========================================
-- AGROSIERRA_TICONA
-- BASE DE DATOS LOCAL - LABORES AGRÍCOLAS
-- SQLDELIGHT
-- ==========================================

CREATE TABLE labor (
    id INTEGER NOT NULL PRIMARY KEY,
    loteId INTEGER NOT NULL,
    tipo TEXT NOT NULL,
    fecha TEXT NOT NULL,
    responsable TEXT NOT NULL,
    cantidad REAL NOT NULL,
    observacion TEXT NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    eliminado INTEGER NOT NULL DEFAULT 0,
    operacionPendiente TEXT NOT NULL DEFAULT 'NINGUNA'
);

-- ==========================================
-- 1. CONSULTAR LABORES POR LOTE
-- ==========================================

seleccionarLaboresPorLote:
SELECT *
FROM labor
WHERE loteId = ?
AND eliminado = 0
ORDER BY fecha DESC, id DESC;

-- ==========================================
-- 2. CONSULTAR LABOR POR ID
-- ==========================================

seleccionarLaborPorId:
SELECT *
FROM labor
WHERE id = ?;

-- ==========================================
-- 3. CONSULTAR LABOR ACTIVA POR ID
-- ==========================================

seleccionarLaborActivaPorId:
SELECT *
FROM labor
WHERE id = ?
AND eliminado = 0;

-- ==========================================
-- 4. CONSULTAR TODAS LAS LABORES ACTIVAS
-- ==========================================

seleccionarLaboresActivas:
SELECT *
FROM labor
WHERE eliminado = 0
ORDER BY fecha DESC, id DESC;

-- ==========================================
-- 5. CONSULTAR LABORES PENDIENTES
-- ==========================================

seleccionarLaboresPendientes:
SELECT *
FROM labor
WHERE pendiente = 1
ORDER BY id ASC;

-- ==========================================
-- 6. LABORES PENDIENTES POR CREAR
-- ==========================================

seleccionarLaboresPorCrear:
SELECT *
FROM labor
WHERE pendiente = 1
AND operacionPendiente = 'CREAR';

-- ==========================================
-- 7. LABORES PENDIENTES POR ACTUALIZAR
-- ==========================================

seleccionarLaboresPorActualizar:
SELECT *
FROM labor
WHERE pendiente = 1
AND operacionPendiente = 'ACTUALIZAR';

-- ==========================================
-- 8. LABORES PENDIENTES POR ELIMINAR
-- ==========================================

seleccionarLaboresPorEliminar:
SELECT *
FROM labor
WHERE pendiente = 1
AND operacionPendiente = 'ELIMINAR';

-- ==========================================
-- 9. CONSULTAR LABORES DESCARTADAS
-- ==========================================

seleccionarLaboresDescartadas:
SELECT *
FROM labor
WHERE operacionPendiente = 'DESCARTAR';

-- ==========================================
-- 10. GENERAR SIGUIENTE ID LOCAL
-- ==========================================
-- Los IDs negativos identifican registros
-- creados localmente sin conexión a internet.
--
-- Ejemplo: -1, -2, -3, -4...

obtenerSiguienteIdLocal:
SELECT COALESCE(MIN(id), 0) - 1
FROM labor
WHERE id < 0;

-- ==========================================
-- 11. INSERTAR O ACTUALIZAR LABOR
-- ==========================================

insertarLabor:
INSERT OR REPLACE INTO labor (
    id,
    loteId,
    tipo,
    fecha,
    responsable,
    cantidad,
    observacion,
    pendiente,
    eliminado,
    operacionPendiente
)
VALUES (
    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?
);

-- ==========================================
-- 12. MARCAR LABOR COMO ELIMINADA
-- ==========================================

marcarLaborEliminada:
UPDATE labor
SET
    eliminado = 1,
    pendiente = 1,
    operacionPendiente =
        CASE
            WHEN operacionPendiente = 'CREAR'
                THEN 'DESCARTAR'
            ELSE 'ELIMINAR'
        END
WHERE id = ?;

-- ==========================================
-- 13. MARCAR LABOR COMO SINCRONIZADA
-- ==========================================

marcarLaborSincronizada:
UPDATE labor
SET
    pendiente = 0,
    operacionPendiente = 'NINGUNA'
WHERE id = ?;

-- ==========================================
-- 14. ELIMINAR LABOR DEFINITIVAMENTE
-- ==========================================

eliminarLabor:
DELETE FROM labor
WHERE id = ?;

-- ==========================================
-- 15. ELIMINAR LABORES DESCARTADAS
-- ==========================================

eliminarLaboresDescartadas:
DELETE FROM labor
WHERE operacionPendiente = 'DESCARTAR';

-- ==========================================
-- 16. CONTAR LABORES PENDIENTES
-- ==========================================

contarLaboresPendientes:
SELECT COUNT(*)
FROM labor
WHERE pendiente = 1
AND operacionPendiente != 'DESCARTAR';
